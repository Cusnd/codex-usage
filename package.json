{
  "name": "@esoren/codex-usage",
  "version": "0.1.4",
  "description": "A local Codex usage dashboard and CLI for exploring projects, tasks, turns, and agent teams.",
  "homepage": "https://github.com/Cusnd/codex-usage#readme",
  "bugs": {
    "url": "https://github.com/Cusnd/codex-usage/issues"
  },
  "keywords": [
    "codex",
    "usage",
    "tokens",
    "analytics",
    "dashboard",
    "cli"
  ],
  "os": [
    "win32",
    "darwin"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "showcase:build": "node scripts/build-showcase.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "prepack": "npm run build 1>&2",
    "start": "node dist/server/index.js",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "package:smoke": "node scripts/package-smoke.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@sinclair/typebox": "^0.34.41",
    "@tanstack/react-query": "^5.90.0",
    "fastify": "^5.6.0",
    "lucide-react": "^1.42.0",
    "luxon": "^3.7.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "recharts": "^3.2.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.0.3",
    "sql.js": "^1.14.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "bin": {
    "codex-usage": "bin/codex-usage.mjs"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cusnd/codex-usage.git"
  },
  "files": [
    "bin/",
    "dist/",
    "skills/",
    "docs/INSTALL_FOR_AGENTS.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "README.zh-CN.md",
    "docs/USER_GUIDE.md",
    "docs/USER_GUIDE.zh-CN.md",
    "docs/TECHNICAL_REFERENCE.md",
    "docs/MACOS_COMPATIBILITY.md",
    "scripts/shell-link.ps1"
  ]
}
