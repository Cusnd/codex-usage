{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "codex-usage-cloud-browser-fixture",
  "main": "browser-worker.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "../build", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/auth/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "codex-usage-cloud-browser-fixture", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../migrations" }],
  "vars": { "APP_ORIGIN": "http://127.0.0.1:18787", "GITHUB_CLIENT_ID": "synthetic-only", "GITHUB_CLIENT_SECRET": "synthetic-only" },
  "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "260910001", "simple": { "limit": 20, "period": 60 } }]
}
