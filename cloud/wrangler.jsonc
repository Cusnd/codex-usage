{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "codex-usage-cloud",
  "main": "src/index.ts",
  "account_id": "522109d0e13773ea8c916cb599f91f06",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "quota.esoren.com", "custom_domain": true }],
  "assets": { "directory": "./build", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/auth/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "codex-usage-cloud", "database_id": "56edc711-905f-44d0-a6c1-93b7aea396b4", "migrations_dir": "migrations" }],
  "vars": { "APP_ORIGIN": "https://quota.esoren.com", "GITHUB_CLIENT_ID": "Ov23lib5pCf2LFFUVUar" },
  "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "260910001", "simple": { "limit": 20, "period": 60 } }],
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 0.1, "logs": { "invocation_logs": false } }
}
