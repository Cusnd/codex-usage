{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node",
      "@cloudflare/vitest-plugin/types"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "../apps/cloud",
    "test",
    "worker-configuration.d.ts",
    "vitest.config.ts"
  ]
}
